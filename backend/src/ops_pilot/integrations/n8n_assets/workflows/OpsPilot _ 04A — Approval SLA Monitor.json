      "id": "4fade870-eb1a-43eb-af7d-d60d057d041a",
      "name": "01 | Schedule Approval Monitoring"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    a.id AS approval_id,\n    a.organization_id,\n    a.incident_id,\n    a.action_type,\n    a.created_at,\n    CASE\n        WHEN a.created_at <= NOW() - INTERVAL '30 minutes'\n            THEN 'escalation'\n        ELSE 'initial'\n    END AS reminder_level\nFROM public.approval_requests AS a\nWHERE a.status = 'pending'\n  AND a.created_at <= NOW() - INTERVAL '15 minutes'\nORDER BY a.created_at\nLIMIT 50;",
        "options": {
          "queryBatching": "single"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "a588df76-b205-4606-bb52-dcb37540910b",
      "name": "02 | Find Overdue Approval Requests",
      "credentials": {
        "postgres": {
          "id": "dkzZ44RtqalwotTh",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n    INSERT INTO automation.approval_reminders (\n        approval_id,\n        organization_id,\n        incident_id,\n        reminder_level\n    )\n    SELECT\n        a.id,\n        a.organization_id,\n        a.incident_id,\n        $4::text\n    FROM public.approval_requests AS a\n    WHERE a.id = $1::uuid\n      AND a.organization_id = $2::uuid\n      AND a.incident_id = $3::uuid\n      AND a.status = 'pending'\n      AND a.created_at <= NOW() -\n          CASE\n              WHEN $4::text = 'escalation'\n                  THEN INTERVAL '30 minutes'\n              ELSE INTERVAL '15 minutes'\n          END\n    ON CONFLICT (approval_id, reminder_level)\n    DO NOTHING\n    RETURNING id, approval_id, reminder_level\n)\nSELECT\n    EXISTS(SELECT 1 FROM saved) AS queued,\n    (SELECT id FROM saved) AS reminder_id;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.approval_id,\n  $json.organization_id,\n  $json.incident_id,\n  $json.reminder_level\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        0
      ],
      "id": "d6c4be60-6a67-4373-97e5-aa9b9c34ac24",
