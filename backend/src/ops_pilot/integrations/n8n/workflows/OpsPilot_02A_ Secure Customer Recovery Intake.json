    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\nconst payload = body.payload ?? {};\n\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nconst validUuid = (value) =>\n  typeof value === \"string\" && uuid.test(value);\n\nconst validText = (value) =>\n  typeof value === \"string\" && value.trim().length > 0;\n\nconst valid =\n  body.event_type === \"incident.customer_recovery\" &&\n  validUuid(body.event_id) &&\n  validUuid(body.organization_id) &&\n  validUuid(payload.incident_id) &&\n  validUuid(payload.customer_id) &&\n  validText(body.occurred_at) &&\n  Number.isFinite(Date.parse(body.occurred_at)) &&\n  validText(payload.title) &&\n  validText(payload.resolution) &&\n  payload.action_type === \"refund_transaction\" &&\n  validText(payload.source_transaction_id) &&\n  validText(payload.refund_transaction_id) &&\n  validText(payload.currency) &&\n  /^[A-Z]{3}$/.test(payload.currency) &&\n  (\n    typeof payload.refund_amount === \"number\" ||\n    typeof payload.refund_amount === \"string\"\n  ) &&\n  /^\\d+(?:\\.\\d+)?$/.test(String(payload.refund_amount)) &&\n  Number(payload.refund_amount) > 0 &&\n  validText(payload.customer_email) &&\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(payload.customer_email);\n\nreturn {\n  json: {\n    valid,\n    event_id: valid ? body.event_id : null,\n    organization_id: valid ? body.organization_id : null,\n    occurred_at: valid ? body.occurred_at : null,\n    payload: valid ? payload : null,\n    error: valid ? null : \"Invalid customer recovery event\"\n  }\n};"
      },
