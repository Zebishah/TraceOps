      "id": "0e37b1ad-552b-4a01-a799-571f5df53a7c",
      "name": "05 | Reject Invalid Recovery Event"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH saved AS (\n    INSERT INTO automation.customer_recovery_events AS r (\n        event_id,\n        organization_id,\n        incident_id,\n        customer_id,\n        refund_transaction_id,\n        source_transaction_id,\n        refund_amount,\n        currency,\n        customer_email,\n        payload\n    )\n    VALUES (\n        $1::uuid,\n        $2::uuid,\n        $3::uuid,\n        $4::uuid,\n        $5::text,\n        $6::text,\n        $7::numeric,\n        $8::text,\n        $9::text,\n        $10::jsonb\n    )\n    ON CONFLICT (organization_id, refund_transaction_id)\n    DO UPDATE SET\n        duplicate_count = r.duplicate_count + 1,\n        last_received_at = NOW()\n    WHERE r.incident_id = EXCLUDED.incident_id\n      AND r.customer_id = EXCLUDED.customer_id\n      AND r.source_transaction_id =\n          EXCLUDED.source_transaction_id\n      AND r.refund_amount = EXCLUDED.refund_amount\n      AND r.currency = EXCLUDED.currency\n    RETURNING r.event_id, r.status, r.duplicate_count\n)\nSELECT\n    EXISTS (SELECT 1 FROM saved) AS accepted,\n    (SELECT status FROM saved) AS recovery_status,\n    (SELECT duplicate_count FROM saved) AS duplicate_count;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.event_id,\n  $json.organization_id,\n  $json.payload.incident_id,\n  $json.payload.customer_id,\n  $json.payload.refund_transaction_id,\n  $json.payload.source_transaction_id,\n  String($json.payload.refund_amount),\n  $json.payload.currency,\n  $json.payload.customer_email,\n  JSON.stringify($json.payload)\n] }}"
        }
      },
