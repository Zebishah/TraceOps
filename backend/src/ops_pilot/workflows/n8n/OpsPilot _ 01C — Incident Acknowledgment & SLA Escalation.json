    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\nconst payload = body.payload ?? {};\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nconst organizationId = body.organization_id;\nconst incidentId = payload.incident_id ?? body.incident_id;\n\nconst valid =\n  body.event_type === \"incident.resolved\" &&\n  typeof organizationId === \"string\" &&\n  typeof incidentId === \"string\" &&\n  uuidPattern.test(organizationId) &&\n  uuidPattern.test(incidentId);\n\nreturn {\n  json: {\n    valid,\n    organization_id: valid ? organizationId : null,\n    incident_id: valid ? incidentId : null,\n    event_id: body.event_id ?? null,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        688
      ],
      "id": "8eb3cea0-66a2-4dbf-942c-b92822fa1851",
      "name": "14 | Validate Incident Resolution"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "5bc62a23-905b-492e-aef5-628684dcf481",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        672,
        688
      ],
      "id": "8ccdae40-b265-493b-9a6d-fd1afff1a021",
      "name": "15 | Valid Resolution Event?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH resolved AS (\n    UPDATE automation.incident_cases AS c\n    SET\n        status = 'resolved',\n        resolved_at = NOW()\n    WHERE c.organization_id = $1::uuid\n      AND c.incident_id = $2::uuid\n      AND c.status IN ('open', 'acknowledged', 'escalated')\n      AND c.resolved_at IS NULL\n    RETURNING\n        c.organization_id,\n        c.incident_id\n),\ncancelled AS (\n    UPDATE automation.notification_tasks AS t\n    SET\n        status = 'dead',\n        last_error = 'Cancelled because incident was resolved',\n        lease_token = NULL,\n        lease_expires_at = NULL,\n        updated_at = NOW()\n    FROM resolved AS r\n    WHERE t.organization_id = r.organization_id\n      AND t.incident_id = r.incident_id\n      AND t.status IN ('pending', 'failed')\n    RETURNING t.id\n)\nSELECT\n    CASE\n        WHEN EXISTS (SELECT 1 FROM resolved)\n            THEN 'resolved'\n        WHEN EXISTS (\n            SELECT 1\n            FROM automation.incident_cases\n            WHERE organization_id = $1::uuid\n              AND incident_id = $2::uuid\n              AND status = 'resolved'\n        )\n            THEN 'already_resolved'\n        ELSE 'not_eligible'\n    END AS result,\n    (SELECT COUNT(*)::integer FROM cancelled)\n        AS notifications_cancelled;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [$json.organization_id, $json.incident_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
