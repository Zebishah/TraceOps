    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    c.organization_id,\n    c.incident_id,\n    c.source_event_id,\n    c.title,\n    c.priority,\n    c.status,\n    c.opened_at,\n    c.acknowledgment_due_at,\n    c.escalation_due_at,\n    NOW() AS checked_at,\n    (c.acknowledgment_due_at <= NOW())\n        AS acknowledgment_overdue\nFROM automation.incident_cases AS c\nWHERE c.status IN ('open', 'escalated')\n  AND c.acknowledged_at IS NULL\n  AND c.escalation_due_at <= NOW()\nORDER BY c.escalation_due_at ASC\nLIMIT 50;",
        "options": {
          "queryBatching": "single"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
