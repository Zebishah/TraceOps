      "id": "ea8f4ed9-91df-4d55-9d84-4c6c85c8d092",
      "name": "03 | Valid Overdue Incident?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH escalated AS (\n    UPDATE automation.incident_cases AS c\n    SET status = 'escalated'\n    WHERE c.organization_id = $1::uuid\n      AND c.incident_id = $2::uuid\n      AND c.status = 'open'\n      AND c.acknowledged_at IS NULL\n      AND c.escalation_due_at <= NOW()\n    RETURNING\n        c.organization_id,\n        c.incident_id\n),\nqueued AS (\n    INSERT INTO automation.notification_tasks (\n        organization_id,\n        incident_id,\n        channel,\n        notification_type\n    )\n    SELECT\n        e.organization_id,\n        e.incident_id,\n        channels.channel,\n        'manager_escalation'\n    FROM escalated AS e\n    CROSS JOIN (\n        VALUES ('discord'), ('email')\n    ) AS channels(channel)\n    ON CONFLICT (\n        organization_id,\n        incident_id,\n        channel,\n        notification_type\n    ) DO NOTHING\n    RETURNING id\n)\nSELECT\n    EXISTS (SELECT 1 FROM escalated)\n        AS escalated,\n    (SELECT COUNT(*)::integer FROM queued)\n        AS notifications_queued;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [$json.organization_id, $json.incident_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        -96
      ],
      "id": "8fd2594b-59ad-40c0-b637-c76f305390af",
