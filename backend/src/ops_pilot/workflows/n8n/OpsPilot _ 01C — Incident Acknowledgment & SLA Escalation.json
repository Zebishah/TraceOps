      "id": "51866ffb-6211-461f-a058-7a8e7f580a92",
      "name": "07 | Receive Incident Acknowledgment",
      "webhookId": "b8784ebc-2783-4360-a34b-3021870f77bc",
      "credentials": {
        "httpHeaderAuth": {
          "id": "6Tlb49Kt9T6hRM0e",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nconst organizationId = body.organization_id;\nconst incidentId = body.incident_id;\nconst responderId = body.responder_id;\n\nconst valid =\n  typeof organizationId === 'string' &&\n  typeof incidentId === 'string' &&\n  typeof responderId === 'string' &&\n  uuidPattern.test(organizationId) &&\n  uuidPattern.test(incidentId) &&\n  responderId.trim().length > 0 &&\n  responderId.length <= 200;\n\nreturn {\n  json: {\n    valid,\n    organization_id: valid ? organizationId : null,\n    incident_id: valid ? incidentId : null,\n    responder_id: valid ? responderId.trim() : null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        240
      ],
      "id": "d4df69bd-b4fe-4246-8a40-4ead40d508aa",
      "name": "08 | Validate Acknowledgment"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "2290749e-5d6b-4352-96fb-8a785877bf57",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        752,
        288
      ],
      "id": "75860711-68e5-4b24-99ac-f7bb6ec46afb",
      "name": "09 | Valid Acknowledgment?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH acknowledged AS (\n    UPDATE automation.incident_cases AS c\n    SET\n        status = 'acknowledged',\n        acknowledged_at = NOW(),\n        acknowledged_by = $3::text\n    WHERE c.organization_id = $1::uuid\n      AND c.incident_id = $2::uuid\n      AND c.status IN ('open', 'escalated')\n      AND c.acknowledged_at IS NULL\n    RETURNING\n        c.organization_id,\n        c.incident_id,\n        c.acknowledged_at,\n        c.acknowledged_by\n),\ncancelled AS (\n    UPDATE automation.notification_tasks AS t\n    SET\n        status = 'dead',\n        last_error = 'Cancelled after incident acknowledgment',\n        lease_token = NULL,\n        lease_expires_at = NULL,\n        updated_at = NOW()\n    FROM acknowledged AS a\n    WHERE t.organization_id = a.organization_id\n      AND t.incident_id = a.incident_id\n      AND t.notification_type = 'manager_escalation'\n      AND t.status IN ('pending', 'failed')\n    RETURNING t.id\n)\nSELECT\n    CASE\n        WHEN EXISTS (SELECT 1 FROM acknowledged)\n            THEN 'acknowledged'\n        WHEN EXISTS (\n            SELECT 1\n            FROM automation.incident_cases\n            WHERE organization_id = $1::uuid\n              AND incident_id = $2::uuid\n              AND acknowledged_at IS NOT NULL\n        )\n            THEN 'already_acknowledged'\n        ELSE 'not_eligible'\n    END AS result,\n    (SELECT acknowledged_at FROM acknowledged) AS acknowledged_at,\n    (SELECT COUNT(*)::integer FROM cancelled)\n        AS notifications_cancelled;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.organization_id,\n  $json.incident_id,\n  $json.responder_id\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        992,
        208
      ],
