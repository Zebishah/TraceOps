            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "fd0eb7f8-4b0c-40df-82d1-728d4a3a050b",
              "leftValue": "={{ $json.escalated }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
