    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT\n    channel,\n    notification_type,\n    status,\n    attempts,\n    created_at\nFROM automation.notification_tasks\nWHERE organization_id = $1::uuid\n  AND incident_id = $2::uuid\n  AND notification_type = 'manager_escalation'\nORDER BY channel;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $('02 | Find Overdue Incident Cases').item.json.organization_id,\n  $('02 | Find Overdue Incident Cases').item.json.incident_id\n] }}"
        }
