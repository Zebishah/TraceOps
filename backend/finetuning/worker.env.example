# Start from ops-pilot/backend with:
# uv run --project finetuning --frozen uvicorn finetuning.serve_classifier:app --env-file finetuning/worker.env --host 127.0.0.1 --port 8001 --workers 1
# The default is production: startup fails until a valid signed release is supplied.
CLASSIFIER_ENVIRONMENT=production
CLASSIFIER_ADAPTER_PATH=/absolute/path/to/verified-adapter
CLASSIFIER_SERVING_TOKEN=replace-with-a-separately-generated-random-secret-at-least-32-characters
CLASSIFIER_RELEASE_MANIFEST=/absolute/path/to/release.json
CLASSIFIER_RELEASE_PUBLIC_KEY=replace-with-the-generated-base64-public-key
CLASSIFIER_DEVICE=cpu
CLASSIFIER_GENERATION_TIMEOUT_SECONDS=8
CLASSIFIER_STARTUP_TIMEOUT_SECONDS=120
CLASSIFIER_CPU_THREADS=2
# Quantization is inherited from the artifact. Do not override CLASSIFIER_QLORA.
# Pre-cache the pinned model before serving in an offline production environment.
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false
