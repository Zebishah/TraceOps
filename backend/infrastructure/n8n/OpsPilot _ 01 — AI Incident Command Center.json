    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT\n    c.organization_id,\n    c.incident_id,\n    c.status AS incident_status,\n\n    EXISTS (\n        SELECT 1\n        FROM automation.notification_tasks t\n        WHERE t.organization_id = c.organization_id\n          AND t.incident_id = c.incident_id\n          AND t.channel = 'discord'\n          AND t.notification_type = 'initial_alert'\n    ) AS discord_task_exists,\n\n    EXISTS (\n        SELECT 1\n        FROM automation.notification_tasks t\n        WHERE t.organization_id = c.organization_id\n          AND t.incident_id = c.incident_id\n          AND t.channel = 'email'\n          AND t.notification_type = 'initial_alert'\n    ) AS email_task_exists,\n\n    c.acknowledgment_due_at,\n    c.escalation_due_at\n\nFROM automation.incident_cases c\n\nWHERE c.organization_id = $1::uuid\n  AND c.incident_id = $2::uuid;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.organization_id,\n  $json.incident_id\n] }}"
        }
