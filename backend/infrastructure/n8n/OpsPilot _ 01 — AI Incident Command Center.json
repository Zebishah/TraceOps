    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst UUID_RE =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nfunction isUuid(value) {\n  return typeof value === \"string\" && UUID_RE.test(value);\n}\n\nfunction cleanText(value, maxLength) {\n  if (typeof value !== \"string\") return null;\n\n  const cleaned = value.trim();\n\n  if (!cleaned || cleaned.length > maxLength) {\n    return null;\n  }\n\n  return cleaned;\n}\n\nfunction validate(input) {\n  const event = input?.body;\n  const errors = [];\n\n  if (\n    !event ||\n    typeof event !== \"object\" ||\n    Array.isArray(event)\n  ) {\n    return {\n      valid: false,\n      errors: [\"Request body must be a JSON object\"],\n    };\n  }\n\n  if (!isUuid(event.event_id)) {\n    errors.push(\"Invalid event_id\");\n  }\n\n  if (event.event_type !== \"incident.high_risk\") {\n    errors.push(\"Unsupported event_type\");\n  }\n\n  if (!isUuid(event.organization_id)) {\n    errors.push(\"Invalid organization_id\");\n  }\n\n  if (\n    typeof event.occurred_at !== \"string\" ||\n    !/^\\d{4}-\\d{2}-\\d{2}T/.test(event.occurred_at) ||\n    !Number.isFinite(Date.parse(event.occurred_at))\n  ) {\n    errors.push(\"Invalid occurred_at\");\n  }\n\n  const payload = event.payload;\n\n  if (\n    !payload ||\n    typeof payload !== \"object\" ||\n    Array.isArray(payload)\n  ) {\n    errors.push(\"Invalid incident payload\");\n  }\n\n  const incidentId = payload?.incident_id;\n  const title = cleanText(payload?.title, 300);\n  const category =\n    payload?.category == null\n      ? null\n      : cleanText(payload.category, 100);\n\n  const priority =\n    typeof payload?.priority === \"string\"\n      ? payload.priority.trim().toLowerCase()\n      : null;\n\n  if (!isUuid(incidentId)) {\n    errors.push(\"Invalid incident_id\");\n  }\n\n  if (!title) {\n    errors.push(\"Invalid incident title\");\n  }\n\n  if (\n    payload?.category != null &&\n    category === null\n  ) {\n    errors.push(\"Invalid incident category\");\n  }\n\n  if (![\"high\", \"critical\"].includes(priority)) {\n    errors.push(\"Priority must be high or critical\");\n  }\n\n  if (errors.length > 0) {\n    return {\n      valid: false,\n      errors,\n      event_id: isUuid(event.event_id)\n        ? event.event_id.toLowerCase()\n        : null,\n    };\n  }\n\n  return {\n    valid: true,\n    errors: [],\n    event_id: event.event_id.toLowerCase(),\n    event_type: \"incident.high_risk\",\n    organization_id: event.organization_id.toLowerCase(),\n    occurred_at: new Date(event.occurred_at).toISOString(),\n\n    incident_id: incidentId.toLowerCase(),\n    title,\n    priority,\n    category,\n\n    acknowledgment_minutes:\n      priority === \"critical\" ? 5 : 15,\n\n    escalation_minutes:\n      priority === \"critical\" ? 10 : 30,\n  };\n}\n\nreturn items.map((item, index) => ({\n  json: validate(item.json),\n  pairedItem: { item: index },\n}));\n"
      },
