        "query": "SELECT *\nFROM automation.intake_high_risk_event(\n    $1::uuid,\n    $2::uuid,\n    $3::uuid,\n    $4::text,\n    $5::text,\n    $6::text,\n    $7::timestamptz,\n    $8::jsonb\n);",
