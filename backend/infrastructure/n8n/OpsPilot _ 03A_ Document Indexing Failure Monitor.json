    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\nconst payload = body.payload ?? {};\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nconst validUuid = (value) =>\n  typeof value === \"string\" && uuidPattern.test(value);\n\nconst validText = (value, maximum) =>\n  typeof value === \"string\" &&\n  value.trim().length > 0 &&\n  value.length <= maximum;\n\nconst valid =\n  body.event_type === \"document.indexing_failed\" &&\n  validUuid(body.event_id) &&\n  validUuid(body.organization_id) &&\n  validUuid(payload.document_id) &&\n  validUuid(payload.job_id) &&\n  validText(payload.filename, 500) &&\n  validText(payload.error_message, 5000) &&\n  typeof body.occurred_at === \"string\" &&\n  Number.isFinite(Date.parse(body.occurred_at));\n\nreturn {\n  json: {\n    valid,\n    event_id: valid ? body.event_id : null,\n    organization_id: valid ? body.organization_id : null,\n    document_id: valid ? payload.document_id : null,\n    job_id: valid ? payload.job_id : null,\n    filename: valid ? payload.filename : null,\n    error_message: valid ? payload.error_message : null,\n    occurred_at: valid ? body.occurred_at : null,\n  },\n};"
      },
