      "name": "03 | Valid Document Failure?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n    INSERT INTO automation.document_failure_events AS d (\n        event_id,\n        organization_id,\n        document_id,\n        job_id,\n        filename,\n        error_message,\n        occurred_at\n    )\n    VALUES (\n        $1::uuid,\n        $2::uuid,\n        $3::uuid,\n        $4::uuid,\n        $5::text,\n        $6::text,\n        $7::timestamptz\n    )\n    ON CONFLICT (organization_id, job_id)\n    DO UPDATE SET\n        duplicate_count = d.duplicate_count + 1\n    WHERE d.event_id = EXCLUDED.event_id\n      AND d.document_id = EXCLUDED.document_id\n      AND d.filename = EXCLUDED.filename\n      AND d.error_message = EXCLUDED.error_message\n      AND d.occurred_at = EXCLUDED.occurred_at\n    RETURNING d.event_id, d.alert_status, d.duplicate_count\n)\nSELECT\n    EXISTS (SELECT 1 FROM saved) AS accepted,\n    (SELECT alert_status FROM saved) AS alert_status,\n    (SELECT duplicate_count FROM saved) AS duplicate_count;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.event_id,\n  $json.organization_id,\n  $json.document_id,\n  $json.job_id,\n  $json.filename,\n  $json.error_message,\n  $json.occurred_at\n] }}"
        }
      },
