    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst incident = $json;\n\nconst priority = String(incident.priority || \"\").toLowerCase();\n\nconst label =\n  priority === \"critical\" ? \"CRITICAL\" : \"HIGH\";\n\nconst safeTitle = String(incident.title || \"\")\n  .replace(/[\\r\\n]+/g, \" \")\n  .trim()\n  .slice(0, 180);\n\nconst subject = `[OpsPilot] ${label} Incident — ${safeTitle}`;\n\nconst body = [\n  \"OPSPILOT — INCIDENT RESPONSE NOTIFICATION\",\n  \"\",\n  `Priority: ${label}`,\n  `Incident: ${safeTitle}`,\n  `Incident ID: ${incident.incident_id}`,\n  `Organization ID: ${incident.organization_id}`,\n  `Current status: ${incident.incident_status}`,\n  \"\",\n  `Acknowledgment deadline: ${incident.acknowledgment_due_at}`,\n  `Escalation deadline: ${incident.escalation_due_at}`,\n  \"\",\n  \"Required action:\",\n  \"Review the incident and assign an authorized responder.\",\n  \"\",\n  \"This is an automated operational notification.\",\n  \"Do not reply with passwords, credentials or payment information.\"\n].join(\"\\n\");\n\nreturn {\n  json: {\n    ...incident,\n    email_subject: subject,\n    email_body: body\n  }\n};\n"
      },
