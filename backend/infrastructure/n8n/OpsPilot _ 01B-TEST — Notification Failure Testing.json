    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    t.id AS task_id,\n    t.organization_id,\n    t.incident_id,\n    t.lease_token,\n    t.attempts,\n    t.notification_type,\n    c.title,\n    c.priority,\n    c.status AS incident_status,\n    c.acknowledgment_due_at,\n    c.escalation_due_at\nFROM automation.notification_tasks AS t\nJOIN automation.incident_cases AS c\n    ON c.organization_id = t.organization_id\n   AND c.incident_id = t.incident_id\nWHERE t.id = $1::uuid\n  AND t.lease_token = $2::uuid\n  AND t.channel = 'discord'\n  AND t.status = 'processing'\n  AND t.lease_expires_at > NOW();",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.task_id,\n  $json.lease_token\n] }}"
        }
