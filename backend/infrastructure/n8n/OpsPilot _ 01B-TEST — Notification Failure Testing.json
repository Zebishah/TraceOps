    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH selected AS (\n    SELECT t.id\n    FROM automation.notification_tasks AS t\n    WHERE t.attempts < 8\n      AND t.id IN (\n      '7b6ca029-df29-4476-9a37-3f6c1737ba39'::uuid,\n      'e2749778-eaab-478e-8314-7b24e46662c8'::uuid\n  )\n      AND t.next_attempt_at <= NOW()\n      AND t.status IN ('pending', 'failed')\n    ORDER BY t.next_attempt_at, t.created_at, t.id\n    FOR UPDATE SKIP LOCKED\n    LIMIT 10\n)\nUPDATE automation.notification_tasks AS task\nSET\n    status = 'processing',\n    attempts = task.attempts + 1,\n    lease_token = gen_random_uuid(),\n    lease_expires_at = NOW() + INTERVAL '2 minutes',\n    updated_at = NOW()\nFROM selected\nWHERE task.id = selected.id\nRETURNING\n    task.id AS task_id,\n    task.organization_id,\n    task.incident_id,\n    task.channel,\n    task.notification_type,\n    task.attempts,\n    task.lease_token,\n    task.lease_expires_at;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        0
      ],
      "id": "9a135dc3-6549-4b34-b1f0-101394a328f1",
      "name": "02 | Claim Pending Notification Tasks",
      "credentials": {
        "postgres": {
          "id": "dkzZ44RtqalwotTh",
          "name": "Postgres account"
        }
