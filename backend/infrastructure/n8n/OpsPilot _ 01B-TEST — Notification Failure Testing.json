      "parameters": {
        "jsCode": "const incident = $json;\n\nconst severity =\n  incident.priority === 'critical'\n    ? '🚨 CRITICAL'\n    : '⚠️ HIGH';\n\nconst message = [\n  `${severity} | OPSPILOT INCIDENT`,\n  '',\n  `Title: ${incident.title}`,\n  `Incident ID: ${incident.incident_id}`,\n  `Organization ID: ${incident.organization_id}`,\n  `Status: ${incident.incident_status}`,\n  `Acknowledgment deadline: ${incident.acknowledgment_due_at}`,\n  `Escalation deadline: ${incident.escalation_due_at}`,\n  '',\n  'Action required: Assign an incident responder.'\n].join('\\n');\n\nreturn {\n  json: {\n    ...incident,\n    discord_message: message.slice(0, 1900)\n  }\n};"
      },
