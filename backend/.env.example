APP_NAME="OpsPilot API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

DATABASE_URL="postgresql+psycopg://username:password@host/database?sslmode=require"
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

REDIS_URL="redis://localhost:6379/0"
REDIS_KEY_PREFIX="ops_pilot"
REDIS_DEFAULT_TTL_SECONDS=300

HEALTH_DEPENDENCY_TIMEOUT_SECONDS=5
# Development example only. Generate your own secret before deployment.
JWT_SECRET_KEY="development-only-replace-with-a-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="your-region"
S3_BUCKET_NAME="your-bucket-name"

QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="ops_pilot_document_chunks_v2"

MISTRAL_API_KEY="your-mistral-api-key"
EMBEDDING_MODEL="mistral-embed"
EMBEDDING_DIMENSION=1024

VOYAGE_API_KEY="your-voyage-api-key"
RERANKER_MODEL="rerank-3-lite"
RETRIEVAL_CANDIDATE_LIMIT=12

GROQ_API_KEY="your-groq-api-key"
GENERATION_MODEL="qwen/qwen3.8-27b"

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV=true

N8N_WEBHOOK_BASE_URL="http://127.0.0.1:5678/webhook"
N8N_WEBHOOK_SECRET="replace-with-a-secret"
N8N_TIMEOUT_SECONDS=10

MCP_AUTHORIZATION_SERVER_URL="http://localhost:8000"
MCP_RESOURCE_URL="http://localhost:8000/mcp"
MCP_ALLOWED_HOSTS="localhost,127.0.0.1"
MCP_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

MISTRAL_TIMEOUT_SECONDS=30
VOYAGE_TIMEOUT_SECONDS=30
GROQ_TIMEOUT_SECONDS=30

ENABLE_APPROVAL_RESUME_CRON=false
ENABLE_PRODUCTION_APPROVAL_RECOVERY=false
APPROVAL_RECOVERY_EXECUTION_ENABLED=false