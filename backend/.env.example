APP_NAME="OpsPilot API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

DATABASE_URL="postgresql+psycopg://username:password@host/database?sslmode=require"

JWT_SECRET_KEY="SOFTWARE_ENGINEERING_IS_AWESOME"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="your-region"
S3_BUCKET_NAME="your-bucket-name"

QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="ops_pilot_document_chunks_v1"


EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
EMBEDDING_DIMENSION=1024

RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"
RETRIEVAL_CANDIDATE_LIMIT=12

GROQ_API_KEY="your-groq-api-key"

GENERATION_MODEL="qwen/qwen3.8-27b"

MISTRAL_API_KEY="mstrl_"

VOYAGE_API_KEY="pa-"
RERANKER_MODEL="rerank-3-lite"