APP_NAME="IncidentIQ API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

DATABASE_URL="postgresql+psycopg://username:password@host/database?sslmode=require"
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

REDIS_URL="redis://localhost:6379/0"
REDIS_KEY_PREFIX="ops_pilot"
REDIS_DEFAULT_TTL_SECONDS=300

HEALTH_DEPENDENCY_TIMEOUT_SECONDS=5
# Development example only. Generate your own secret before deployment.
JWT_SECRET_KEY="development-only-replace-with-a-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="your-region"
S3_BUCKET_NAME="your-bucket-name"

QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="ops_pilot_document_chunks_v2"

MISTRAL_API_KEY="your-mistral-api-key"
EMBEDDING_MODEL="mistral-embed"
EMBEDDING_DIMENSION=1024

VOYAGE_API_KEY="your-voyage-api-key"
RERANKER_MODEL="rerank-3-lite"
RETRIEVAL_CANDIDATE_LIMIT=12

GROQ_API_KEY="your-groq-api-key"
GENERATION_MODEL="qwen/qwen3.8-27b"

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV=true

N8N_WEBHOOK_BASE_URL="http://127.0.0.1:5678/webhook"
N8N_WEBHOOK_SECRET="replace-with-a-secret"
N8N_TIMEOUT_SECONDS=10

MCP_AUTHORIZATION_SERVER_URL="http://localhost:8000"
MCP_RESOURCE_URL="http://localhost:8000/mcp"
MCP_ALLOWED_HOSTS="localhost,127.0.0.1"
MCP_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

MISTRAL_TIMEOUT_SECONDS=30
VOYAGE_TIMEOUT_SECONDS=30
GROQ_TIMEOUT_SECONDS=30

ENABLE_APPROVAL_RESUME_CRON=false
ENABLE_PRODUCTION_APPROVAL_RECOVERY=false
APPROVAL_RECOVERY_EXECUTION_ENABLED=false

# Voice is additive and opt-in. Transcripts never create incidents automatically.
# Set true on the backend deployment to enable transcription; restart after changing.
# Uses the existing GROQ_API_KEY and REDIS_URL. Keep keys off the frontend.
VOICE_ENABLED=false
VOICE_TTS_ENABLED=false
VOICE_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
VOICE_TTS_VOICE=troy
VOICE_TIMEOUT_SECONDS=30
VOICE_REQUESTS_PER_MINUTE=10

# Keep groq until a separately trained/served adapter passes evaluation.
INCIDENT_CLASSIFIER_BACKEND=groq
# FINETUNED_CLASSIFIER_URL=http://127.0.0.1:8001/classify
# FINETUNED_CLASSIFIER_TOKEN=generate-a-separate-random-secret-at-least-32-characters
FINETUNED_CLASSIFIER_TIMEOUT_SECONDS=10
FINETUNED_CLASSIFIER_FALLBACK_ENABLED=true
# Required before selecting finetuned in production. Printed by release approval.
# FINETUNED_CLASSIFIER_RELEASE_ID=approved-release-sha256

# Resend email verification. Deploy the migration and frontend before enabling.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=IncidentIQ <opspilot@nagumo-spot.isroot.in>
FRONTEND_BASE_URL=http://localhost:5173
# Optional bounds (defaults shown).
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_DAILY_LIMIT=80
EMAIL_DELIVERY_TIMEOUT_SECONDS=10
